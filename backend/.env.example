# ==========================================================================
# Invoice Error Detector — backend environment template
# Copy this file to `.env` (same folder) and adjust values as needed.
# ==========================================================================

# --- Application ---
APP_NAME=Invoice Error Detector API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
# MySQL (production target). Create the database first:
#   CREATE DATABASE invoice_db CHARACTER SET utf8mb4;
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/invoice_db?charset=utf8mb4
# For local zero-setup development (no MySQL server required), use instead:
# DATABASE_URL=sqlite:///./invoice_detector.db
DB_ECHO=false

# --- CORS: React frontend origins (comma-separated) ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Validation rules (used in later phases) ---
PRICE_OUTLIER_THRESHOLD=3000
AMOUNT_TOLERANCE=1.0

# --- ML engine (used in later phases) ---
ML_ENABLED=true
MODEL_PATH=ml_engine/model.pkl
SCALER_PATH=ml_engine/scaler.pkl

# --- Demo authentication (used in later phases) ---
DEMO_USER=admin
DEMO_PASSWORD=admin123